 "recurrence_min_support": 3,
 "detector": "detect_titles.py (same folder): detect(left, surface, right, lang, coll) -> None | {cat, title, rule, lg, part, support}",
 "rules": {
  "direct": "TITLE [given name(s)] PARTICLE [article] [qualifier] PLACE, e.g. King of France, Duke Robert of Normandy, Roy d'Escosse, Herzog zu Sachsen, il re di Francia, my Lord of Salisbury",
  "surface": "the surface itself starts with the title (Roy de France, Duke of Anjou, Bishop of Chester his Inne)",
  "chain": "place in the list that follows a title (King of England, France and Ireland); German / Dutch lists only with slashes; a comma needs a continuation",
  "latin": "bare Latin: TITLE + genitive / ecclesiastical adjective of a realm, a duchy or a see (rex Franciae, dux Saxoniae, episcopus Wintoniensis); other genitives (cities) are not taken",
  "latin_after": "the place (genitive or adjective) followed by the title (Franciae regem, Tigurinae episcopo)",
  "de_genitive": "German genitive in -s followed by the title (Frankreichs Konig)",
  "tei_nesting": "place element inside roleName / rs[@type=person] / persName whose parent text carries a title word (editors only, rows where every occurrence of the surface in the file is nested)"
 },
 "guards": {
  "not_a_title": [
   "kingdom / royaume / regnum / duchy / duche / Konigreich / Bistum ... (whole words only: the match is on the title word, not on the realm)",
   "vice-roy, viceroy",
   "office words between title and place (Lord Mayor of London, Lord Chancellor of England, Earl Marshall of England, Kaiserlicher Gesandter ...)",
   "place-noun words (Queenhithe, Duke Street, Bishop Auckland, Kings Lynn, Abbots Langley)",
   "Our Lady of ..., Notre Dame de ...",
   "comte = county (comte, conte, vicomte, viscomte with an accent)",
   "surnames: Goody King, Mary King of Kensington, Mr King; in the Casebooks register any title word after a given name or at the start of the line",
   "locative: Kaiser zu Regensburg, Cardinal zu Rom, Konig von Wien nach Olmutz; German zu / in / bei followed by a verb of presence or movement",
   "emperor of a town (empereur de Ratisbone): only for realms",
   "Barons of London, les seigneurs de Venise (a government, not a title)"
  ],
